# --- PROJECT SETUP ---
PROJECT_NAME           = "FMP Game Project"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# --- INPUT SETTINGS ---
# Points specifically to your FMP/Source folder
INPUT                  = FMP/Source
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.cpp *.hpp *.c
EXCLUDE_PATTERNS       = */Intermediate/* */Binaries/* */Build/*

# --- UNREAL ENGINE MACRO HANDLING ---
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "UFUNCTION(...)=" \
                         "UPROPERTY(...)=" \
                         "UCLASS(...)=" \
                         "USTRUCT(...)=" \
                         "UENUM(...)=" \
                         "GENERATED_BODY()=" \
                         "FORCEINLINE=inline"

# --- EXTRACTION SETTINGS ---
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# --- OUTPUT FORMATS ---
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# --- GRAPHS (DISABLED) ---
HAVE_DOT               = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO